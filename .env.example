# WalletConnect Cloud Project ID (optional).
# Leave empty to support injected wallets only (MetaMask / Rabby / OKX ...).
# Get one at https://cloud.walletconnect.com
VITE_WC_PROJECT_ID=

# Google Safe Browsing API v5 key (optional).
# Leave empty to rely on the MetaMask phishing list + local rules only.
VITE_GSB_API_KEY=

# Application name written into calldata prefix "<APP_NAME>:U1:<url>" (optional, default EURL).
VITE_APP_NAME=

# Comma-separated list of selectable link domains (short links use these as the host instead of the
# current origin). Each domain must be configured to point at this app. Leave empty to use the
# current origin (default).
VITE_LINK_DOMAINS=www.com.kg,🔗.eu.org,kurl.eu.org

# Comma-separated list of allowed wallet addresses (lowercase hex) for private deployments.
# When non-empty, only these wallets can create short links and visit/resolve them.
# Leave empty to allow everyone.
VITE_WALLET_WHITELIST=

# Comma-separated chain prefixes hidden from the frontend chain selector.
# Hidden chains remain valid for resolving links but are not shown for creation.
# Leave empty to show all chains.
VITE_HIDDEN_CHAINS=

# Comma-separated chain prefixes shown directly as chain chips.
# Other visible chains are grouped behind the "More" button (modal picker).
# Leave empty to show all visible chains as chips.
VITE_MAIN_CHAINS=

# Comma-separated allowed chain prefixes for private deployments.
# When non-empty, only these chains can create short links and be resolved/redirected.
# Leave empty to allow all chains.
VITE_CHAIN_WHITELIST=

# Comma-separated blocked chain prefixes.
# Short links on these chains cannot be created or redirected.
# Leave empty to block none.
VITE_CHAIN_BLACKLIST=
